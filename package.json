{
  "name": "dspeak-media-control",
  "version": "1.0.0",
  "description": "Cloudflare Worker + Durable Object media control plane for dSpeak",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
