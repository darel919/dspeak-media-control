# dspeak-media-control — Cloudflare Worker + Durable Object
#
# Local dev: copy to .env (gitignored), wrangler dev reads it automatically.
# Cloudflare deploy: set via `wrangler secret put <NAME>` for secrets,
# plain vars are already in wrangler.toml [vars].

# ── Key material (ED25519) ────────────────────────────────────────────────
# Media ticket: ISSUED BY dspeak (Vercel) with the PRIVATE key.
# This worker/DO verifies with the PUBLIC key only — never ship the media
# ticket private key here.
MEDIA_TICKET_PUBLIC_KEY=
# base64 or PEM Ed25519 public key matching the dspeak MEDIA_TICKET_PRIVATE_KEY

# Provider ticket: ISSUED BY THIS WORKER/DO for dspeak-sfu.
# dspeak-sfu verifies with the matching public key.
PROVIDER_TICKET_PRIVATE_KEY=
# base64 or PEM Ed25519 private key for signing provider tickets (aud=dspeak-sfu)

# ── Optional overrides (defaults live in wrangler.toml [vars]) ────────────
# MEDIA_CONTROL_ISSUER=dspeak-media-control
# PROVIDER_TICKET_TTL_SECONDS=120