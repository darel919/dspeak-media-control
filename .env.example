# dspeak-media-control — Cloudflare Worker + Durable Object
#
# Local dev: copy to .env (gitignored), wrangler dev reads it automatically.
# Cloudflare deploy: set via `wrangler secret put <NAME>` for secrets,
# plain vars are already in wrangler.toml [vars].

# ── KEYPAIR 1: media tickets (dspeak <-> this worker) ─────────────────────
# One Ed25519 keypair, split across TWO deployments:
#   - dspeak (Vercel) keeps  the PRIVATE half  -> MEDIA_TICKET_PRIVATE_KEY there
#   - this worker keeps     the PUBLIC half   -> MEDIA_TICKET_PUBLIC_KEY here
# Same keypair, generated on either side. dspeak signs, this worker verifies.
#
# Generate (run once, keep BOTH files safe):
#   openssl genpkey -algorithm Ed25519 -out media-ticket-private.pem
#   openssl pkey  -in media-ticket-private.pem -pubout -out media-ticket-public.pem
#   base64 -i media-ticket-public.pem    # copy into MEDIA_TICKET_PUBLIC_KEY (here)
#   base64 -i media-ticket-private.pem   # copy into MEDIA_TICKET_PRIVATE_KEY (dspeak)
MEDIA_TICKET_PUBLIC_KEY=

# ── KEYPAIR 2 (provider tickets, this worker <-> dspeak-sfu) ──────────────
# Separate Ed25519 keypair, entirely OWNED by this worker.
#   - this worker keeps  the PRIVATE half  -> PROVIDER_TICKET_PRIVATE_KEY (here)
#   - dspeak-sfu gets     the PUBLIC half   -> DSPEAK_MEDIA_TICKET_PUBLIC_KEY there
# Generate:
#   openssl genpkey -algorithm Ed25519 -out provider-ticket-private.pem
#   openssl pkey  -in provider-ticket-private.pem -pubout -out provider-ticket-public.pem
#   base64 -i provider-ticket-private.pem  # -> PROVIDER_TICKET_PRIVATE_KEY (here)
#   base64 -i provider-ticket-public.pem   # -> DSPEAK_MEDIA_TICKET_PUBLIC_KEY (dspeak-sfu)
PROVIDER_TICKET_PRIVATE_KEY=

# Shared by dSpeak API and this worker for provider registry/admin calls.
MEDIA_CONTROL_ADMIN_TOKEN=

# ── Optional overrides (defaults in wrangler.toml [vars]) ──────────────────
# MEDIA_CONTROL_ISSUER=dspeak-media-control
# PROVIDER_TICKET_TTL_SECONDS=120